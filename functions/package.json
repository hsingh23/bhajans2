{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "main": "src/index.js",
  "devDependencies": {
    "firebase-tools": "^15.30.2"
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/mail.js",
    "test": "node --test test/*.test.cjs",
    "deploy": "firebase deploy --config ../firebase.json --only functions:default:amritabooks,functions:default:shopifyWebhook,functions:default:manuallyAddUser,functions:default:paidNotification",
    "serve": "firebase emulators:start --config ../firebase.json --only functions"
  },
  "engines": {
    "node": "24"
  },
  "private": true,
  "type": "commonjs"
}
