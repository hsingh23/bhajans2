{
  "_comment": "Ordered rewrite rules that turn a romanized Indian song title into one phonetic key, applied to each lowercase folded word in order. Shared by src/bkey.js and create-index/bkey.py; both read only pattern and replacement. Patterns use no lookbehind so old Safari can run them. See create-index/sheet-match/research-transliteration-search.md.",
  "rules": [
    ["zh", "l", "R1 zha: azhagu = alagu"],
    ["ksh|x", "ks", "R2 ksa: lakshmi = laxmi = laksmi"],
    ["^(jn|gn|gy|jny|dny)", "gn", "R3 jna, word-initial: jnana = gyan = gnana"],
    ["(jn|gy|jny|dny)", "gn", "R3b jna, medial"],
    ["^(nj|ny)", "n", "R4 Malayalam word-initial nya: njan = nan"],
    ["chh|ch", "c", "R5 c/ch: chandra = candra"],
    ["([^aeioun])h", "$1", "R6a aspirates and sh, but keep nh (kanha != kana)"],
    ["([a-z])h$", "$1", "R6b visarga: namah = nama"],
    ["w", "v", "R7 w/v"],
    ["f", "p", "R7 f/ph"],
    ["q", "k", "R7 q/k"],
    ["z", "j", "R7 z/j"],
    ["ee|ii|ie", "i", "R8 vowel length"],
    ["oo|uu", "u", "R8 vowel length"],
    ["aa+", "a", "R8 vowel length"],
    ["ou|ow", "au", "R9 gourango = gaurango"],
    ["esv", "isv", "R10 -isvara- morpheme: eshwari = ishvari"],
    ["([^aeiou])r[iu]([^aeiouy])", "$1r$2", "R11 vocalic r: krishna = krushna = krsna"],
    ["iy", "y", "R12 glide"],
    ["m([^aeiouymvrl])", "n$1", "R13 anusvara: shamkara = sankara"],
    ["nt", "nd", "R14 post-nasal voicing"],
    ["nk", "ng", "R14 post-nasal voicing"],
    ["mp", "mb", "R14 post-nasal voicing"],
    ["nc", "nj", "R14 post-nasal voicing"],
    ["([a-z])\\1+", "$1", "R15 gemination: amma = ama"],
    ["ai$", "ay", "R16 jai = jay"],
    ["^(.{2,}[^aeiou])a$", "$1", "R17 final schwa after a stem of 3+ letters: rama = ram, amma stays"]
  ],
  "tags": ["malayalam", "hindi", "sanskrit", "tamil", "telugu", "kannada", "bengali", "marathi", "gujarati", "gujrati", "punjabi", "oriya", "odiya", "odia", "tulu", "english", "french", "german", "spanish", "italian", "japanese", "finnish", "hebrew", "assamese", "nepali", "konkani", "rajasthani", "bhojpuri", "urdu", "braj", "bhasha", "version", "namavali", "vintage", "old", "new"],
